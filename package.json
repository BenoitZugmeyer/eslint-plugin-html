{
  "name": "eslint-plugin-html",
  "version": "8.2.1",
  "description": "A ESLint plugin to lint and fix inline scripts contained in HTML files.",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenoitZugmeyer/eslint-plugin-html"
  },
  "homepage": "https://github.com/BenoitZugmeyer/eslint-plugin-html",
  "bugs": "https://github.com/BenoitZugmeyer/eslint-plugin-html/issues",
  "keywords": [
    "eslint-plugin",
    "eslintplugin",
    "eslint",
    "html"
  ],
  "main": "dist/main.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/main.js"
      },
      "require": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@eslint/plugin-kit": "^0.7.3",
    "css-selector-parser": "^3.3.0",
    "eslint-scope": "^9.1.2",
    "eslint-visitor-keys": "^5.0.1",
    "espree": "^11.2.0",
    "htmlparser2": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@html-eslint/parser": "^0.67.0",
    "@types/estree": "^1.0.9",
    "@types/node": "~20.19.43",
    "@types/semver": "^7.8.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "markdown-link-check": "^3.15.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "validate": "npm run lint && npm run typecheck && npm run test",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --check .",
    "prepack": "npm run build"
  }
}
